{
  "name": "morg3a",
  "version": "1.0.0",
  "description": "morg3a is an e-learning platform that helps teachers organize their lessons and students learn more effectively.",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node --env-file=.env dist/server.js",
    "dev": "tsx watch --clear-screen=false --env-file=.env src/server.ts",
    "start:prod": "npm run build && npm start",
    "migrate": "drizzle-kit migrate"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mahmoudalnkeeb/morg3a.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/mahmoudalnkeeb/morg3a/issues"
  },
  "homepage": "https://github.com/mahmoudalnkeeb/morg3a#readme",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.919.0",
    "@aws-sdk/s3-request-presigner": "^3.922.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.44.6",
    "drizzle-zod": "^0.8.3",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "notificationapi-node-server-sdk": "^2.6.0",
    "pg": "^8.16.3",
    "winston": "^3.18.3",
    "zod": "^4.1.12",
    "zod-openapi": "^5.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/helmet": "^0.0.48",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.8.1",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.6",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
